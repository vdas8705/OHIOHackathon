# ============================================================
# BranchPoint environment configuration
# Copy this file to backend/.env and fill in values to enable
# live AI-powered interviews. Without a key, the app runs in
# a clearly labeled DEMO MODE with a predefined scenario.
# ============================================================

# ---- LLM provider selection ----
# Supported: "openai" (default) or "demo" to force demo mode.
LLM_PROVIDER=openai

# ---- OpenAI (or OpenAI-compatible) configuration ----
# Required for live AI. If empty, the backend falls back to demo mode.
OPENAI_API_KEY=
# Model used for scenario generation, interviewer turns, and evaluation.
OPENAI_MODEL=gpt-4o-mini
# Optional: override the base URL for OpenAI-compatible providers
# (e.g. Azure OpenAI, local servers, OpenRouter).
OPENAI_BASE_URL=https://api.openai.com/v1

# ---- Request tuning ----
# Bounded timeout (seconds) for LLM calls.
LLM_TIMEOUT_SECONDS=45
# Number of retries when the model returns malformed JSON.
LLM_MAX_RETRIES=2

# ---- CORS ----
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
