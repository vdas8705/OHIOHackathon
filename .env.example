# ============================================================
# BranchPoint environment configuration
# Copy this file to backend/.env and fill in values to enable
# live AI-powered interviews. Without a key, the app runs in
# a clearly labeled DEMO MODE with a predefined scenario.
# ============================================================

# ---- LLM provider selection ----
# Supported: "openai", "anthropic", or "demo" to force demo mode.
LLM_PROVIDER=anthropic

# ---- Anthropic (Claude) configuration ----
# Required when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY="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"
# Model used for scenario generation, interviewer turns, and evaluation.
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ---- OpenAI (or OpenAI-compatible) configuration ----
# Required when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ---- Request tuning ----
# Bounded timeout (seconds) for LLM calls.
LLM_TIMEOUT_SECONDS=45
# Number of retries when the model returns malformed JSON.
LLM_MAX_RETRIES=2

# ---- CORS ----
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
